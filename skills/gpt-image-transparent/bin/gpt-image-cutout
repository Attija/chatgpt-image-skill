#!/usr/bin/env python3
"""Finish, check or cut out a transparent PNG. Python 3 standard library only.

Usage:
  gpt-image-cutout <source.png> <output.png> [options]

Methods (--method):
  auto     (default) source has a real alpha channel -> "finish"; otherwise -> "chroma"
  finish   clean up an RGBA image from Codex: near-opaque alpha (>= --opaque-from) becomes
           255, near-zero alpha (<= --clear-below) becomes 0, soft edges stay as they are
  chroma   key out a flat background colour (measured on the border, or --key)
  vision   Apple Vision foreground mask (macOS 14+, needs swiftc)

Options:
  --key auto|green|magenta|blue|white|#RRGGBB   background colour for chroma (default auto)
  --tolerance T    chroma: key-likeness above which a pixel is fully transparent (default 0.80)
  --softness S     chroma: width of the soft band below T (default 0.55)
  --opaque-from N  alpha >= N becomes 255 (default 245)
  --clear-below N  alpha <= N becomes 0 (default 4)
  --min-speck PX   drop loose opaque specks smaller than PX pixels (default 64; 0 = off)
  --holes          chroma with a white/grey key: also clear enclosed background (e.g. a mug
                   handle); off by default because subjects often contain white
  --no-fill-holes  keep enclosed half-transparent areas (glass, smoke). By default an enclosed
                   see-through blotch that is nowhere fully transparent is made solid (a
                   matting error); real holes that reach alpha 0 are always kept
  --no-despill     chroma: keep the original edge colours
  --despill        vision: unmix the median border colour from soft edges (off by default;
                   only useful when the background is roughly one colour)
  --trim [PAD]     crop to the subject plus PAD pixels (default 8)
  --overwrite      allow replacing an existing output

Writes <output.png> (RGBA) and <output>.preview.png (checkerboard | black | white) and prints
JSON stats ("source_has_alpha" = the source already had real transparency).
Exit codes: 0 ok; 2 bad arguments or file; 4 not usable: background not flat for chroma,
--method finish on a source without transparency, or nothing left after the cut-out;
5 vision unavailable or found no subject.
"""
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import zlib
from collections import deque

PNG_SIG = b"\x89PNG\r\n\x1a\n"
CACHE = os.path.expanduser(os.environ.get("XDG_CACHE_HOME", "~/.cache"))
VISION_BIN = os.path.join(CACHE, "gpt-image-transparent", "vision-mask")
NAMED_KEYS = {"green": (0, 255, 0), "magenta": (255, 0, 255), "blue": (0, 0, 255),
              "white": (255, 255, 255)}


def die(msg, code=2):
    print(f"gpt-image-cutout: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- PNG I/O (8-bit, non-interlaced)

def read_png(path, _converted=False):
    """Return (width, height, channels, pixels bytearray) with channels 3 (RGB) or 4 (RGBA).
    Handles bit depths 1/2/4/8/16; interlaced PNGs are converted with sips on macOS."""
    with open(path, "rb") as f:
        data = f.read()
    if data[:8] != PNG_SIG:
        die(f"not a PNG file: {path}")
    pos, idat, palette, trns = 8, [], None, None
    width = height = depth = ctype = interlace = None
    while pos < len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + length]
        pos += 12 + length
        if kind == b"IHDR":
            width, height, depth, ctype, _, _, interlace = struct.unpack(">IIBBBBB", body)
        elif kind == b"PLTE":
            palette = body
        elif kind == b"tRNS":
            trns = body
        elif kind == b"IDAT":
            idat.append(body)
        elif kind == b"IEND":
            break
    if interlace:
        if not _converted and shutil.which("sips"):
            tmp = tempfile.NamedTemporaryFile(suffix=".png", delete=False)
            tmp.close()
            try:
                r = subprocess.run(["sips", "-s", "format", "png", path, "--out", tmp.name],
                                   capture_output=True, text=True)
                if r.returncode == 0:
                    return read_png(tmp.name, _converted=True)
            finally:
                os.unlink(tmp.name)
        die(f"unsupported PNG (interlaced; re-save it without interlacing): {path}")
    samples = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(ctype)
    if samples is None or depth not in (1, 2, 4, 8, 16) or (depth > 8 and ctype == 3) \
            or (depth < 8 and ctype not in (0, 3)):
        die(f"unsupported PNG (colour type {ctype}, {depth}-bit): {path}")
    raw = zlib.decompress(b"".join(idat))
    bpp = max(1, samples * depth // 8)
    stride = (width * samples * depth + 7) // 8
    out = bytearray(height * stride)
    prev = bytearray(stride)
    i = 0
    for y in range(height):
        ftype = raw[i]
        row = bytearray(raw[i + 1:i + 1 + stride])
        i += 1 + stride
        if ftype == 1:
            for x in range(bpp, stride):
                row[x] = (row[x] + row[x - bpp]) & 255
        elif ftype == 2:
            row = bytearray((a + b) & 255 for a, b in zip(row, prev))
        elif ftype == 3:
            for x in range(stride):
                left = row[x - bpp] if x >= bpp else 0
                row[x] = (row[x] + ((left + prev[x]) >> 1)) & 255
        elif ftype == 4:
            for x in range(stride):
                a = row[x - bpp] if x >= bpp else 0
                b = prev[x]
                c = prev[x - bpp] if x >= bpp else 0
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                row[x] = (row[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        elif ftype != 0:
            die(f"corrupt PNG filter type {ftype}: {path}")
        out[y * stride:(y + 1) * stride] = row
        prev = row
    if depth == 16:
        out = out[0::2]  # keep the high byte of every sample
    elif depth < 8:
        mask, n = (1 << depth) - 1, width * samples
        scale = 1 if ctype == 3 else 255 // mask
        unpacked = bytearray()
        for y in range(height):
            row = out[y * stride:(y + 1) * stride]
            vals = [((b >> sh) & mask) * scale for b in row for sh in range(8 - depth, -1, -depth)]
            unpacked += bytes(vals[:n])
        out = unpacked
    if ctype == 6:
        return width, height, 4, out
    if ctype == 2:
        return width, height, 3, out
    if ctype == 0:
        return width, height, 3, bytearray(v for g in out for v in (g, g, g))
    if ctype == 4:
        return width, height, 4, bytearray(v for k in range(0, len(out), 2)
                                           for v in (out[k], out[k], out[k], out[k + 1]))
    # palette
    alpha = trns or b""
    has_alpha = bool(alpha)
    px = bytearray()
    for idx in out:
        px += palette[idx * 3:idx * 3 + 3]
        if has_alpha:
            px.append(alpha[idx] if idx < len(alpha) else 255)
    return width, height, (4 if has_alpha else 3), px


def write_png(path, width, height, channels, pixels):
    """Write 8-bit RGB/RGBA/gray with the Up filter (row minus previous row)."""
    ctype = {1: 0, 3: 2, 4: 6}[channels]
    stride = width * channels
    raw = bytearray()
    prev = bytes(stride)
    for y in range(height):
        row = pixels[y * stride:(y + 1) * stride]
        raw.append(2)
        raw += bytes((a - b) & 255 for a, b in zip(row, prev))
        prev = row

    def chunk(kind, body):
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body) & 0xFFFFFFFF)

    with open(path, "wb") as f:
        f.write(PNG_SIG)
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, ctype, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(bytes(raw), 6)))
        f.write(chunk(b"IEND", b""))


def load_image(path):
    ext = os.path.splitext(path)[1].lower()
    if ext == ".png":
        return read_png(path)
    if ext in (".jpg", ".jpeg", ".webp") and shutil.which("sips"):
        tmp = tempfile.NamedTemporaryFile(suffix=".png", delete=False)
        tmp.close()
        try:
            r = subprocess.run(["sips", "-s", "format", "png", path, "--out", tmp.name],
                               capture_output=True, text=True)
            if r.returncode != 0:
                die(f"could not convert {path} to PNG: {r.stderr.strip()}")
            return read_png(tmp.name)
        finally:
            os.unlink(tmp.name)
    die(f"source must be a PNG (JPEG/WebP only on macOS via sips): {path}")


# ---------------------------------------------------------------- helpers

def border_pixels(w, h, ch, px, band=4):
    idx = set()
    for y in range(h):
        if y < band or y >= h - band:
            idx.update(range(y * w, y * w + w))
        else:
            idx.update(range(y * w, y * w + band))
            idx.update(range(y * w + w - band, y * w + w))
    return [(px[i * ch], px[i * ch + 1], px[i * ch + 2]) for i in idx], idx


def median(values):
    s = sorted(values)
    return s[len(s) // 2]


def key_kind(key):
    r, g, b = key
    if g - max(r, b) > 80:
        return "green"
    if min(r, b) - g > 80:
        return "magenta"
    if b - max(r, g) > 80:
        return "blue"
    return "distance"


def dominance(kind, r, g, b):
    if kind == "green":
        return g - (r if r > b else b)
    if kind == "magenta":
        return (r if r < b else b) - g
    return b - (r if r > g else g)  # blue


def remove_specks(w, h, alpha, min_size):
    """Zero opaque-ish components smaller than min_size; returns number of pieces kept."""
    if min_size <= 0:
        min_size = 1
    seen = bytearray(w * h)
    kept = 0
    for start in range(w * h):
        if alpha[start] == 0 or seen[start]:
            continue
        comp, q = [], deque([start])
        seen[start] = 1
        while q:
            i = q.popleft()
            comp.append(i)
            x = i % w
            for j in (i - w, i + w, i - 1 if x else -1, i + 1 if x < w - 1 else -1):
                if 0 <= j < w * h and not seen[j] and alpha[j]:
                    seen[j] = 1
                    q.append(j)
        if len(comp) < min_size:
            for i in comp:
                alpha[i] = 0
        else:
            kept += 1
    return kept


def fill_false_holes(w, h, alpha):
    """Make enclosed see-through blotches solid. A real hole (mug handle, gap between leaves)
    is fully transparent somewhere inside; a matting error inside solid material never is.
    Returns the number of pixels filled."""
    n = w * h
    outside = bytearray(n)
    q = deque(i for i in range(n) if (i < w or i >= n - w or i % w in (0, w - 1)) and alpha[i] < 255)
    for i in q:
        outside[i] = 1
    while q:
        i = q.popleft()
        x = i % w
        for j in (i - w, i + w, i - 1 if x else -1, i + 1 if x < w - 1 else -1):
            if 0 <= j < n and not outside[j] and alpha[j] < 255:
                outside[j] = 1
                q.append(j)
    seen = bytearray(n)
    filled = 0
    for start in range(n):
        if alpha[start] == 255 or outside[start] or seen[start]:
            continue
        comp, q = [], deque([start])
        seen[start] = 1
        while q:
            i = q.popleft()
            comp.append(i)
            x = i % w
            for j in (i - w, i + w, i - 1 if x else -1, i + 1 if x < w - 1 else -1):
                if 0 <= j < n and not seen[j] and alpha[j] < 255 and not outside[j]:
                    seen[j] = 1
                    q.append(j)
        if min(alpha[i] for i in comp) > 0:
            for i in comp:
                alpha[i] = 255
            filled += len(comp)
    return filled


# ---------------------------------------------------------------- methods

def snap_alpha(alpha, opaque_from, clear_below):
    """Near-opaque becomes 255, near-zero becomes 0; soft edges in between stay."""
    for i, a in enumerate(alpha):
        if a >= opaque_from:
            alpha[i] = 255
        elif a <= clear_below:
            alpha[i] = 0


def method_finish(w, h, px):
    rgb = bytearray(w * h * 3)
    rgb[0::3], rgb[1::3], rgb[2::3] = px[0::4], px[1::4], px[2::4]
    return rgb, bytearray(px[3::4])


def method_chroma(w, h, ch, px, key_arg, tolerance, softness, despill, holes=False):
    border, border_idx = border_pixels(w, h, ch, px)
    if key_arg == "auto":
        key = tuple(median([p[c] for p in border]) for c in range(3))
    elif key_arg in NAMED_KEYS:
        key = NAMED_KEYS[key_arg]
    else:
        try:
            key = tuple(int(key_arg.lstrip("#")[k:k + 2], 16) for k in (0, 2, 4))
        except ValueError:
            die(f"invalid --key: {key_arg}")
    kind = key_kind(key)
    kr, kg, kb = key

    if kind == "distance":
        def likeness(r, g, b):
            d = ((r - kr) ** 2 + (g - kg) ** 2 + (b - kb) ** 2) ** 0.5 / 441.7
            return 1 - d / 0.25 if d < 0.25 else 0.0
    else:
        kdom = max(dominance(kind, kr, kg, kb), 1)

        def likeness(r, g, b):
            return dominance(kind, r, g, b) / kdom

    near = sum(1 for p in border if likeness(*p) >= tolerance)
    uniform = near / len(border)
    if uniform < 0.90:
        die(f"background is not a flat colour (only {uniform:.0%} of the border matches key "
            f"#{kr:02x}{kg:02x}{kb:02x}). Regenerate on a flat background or use --method vision.", 4)

    lo = tolerance - softness
    n = w * h
    likes = [likeness(px[i * ch], px[i * ch + 1], px[i * ch + 2]) for i in range(n)]
    # Saturated chroma keys never occur in the subject, so every key-like pixel goes (holes too).
    # A white/grey key does occur in subjects (eyes, highlights, a cream chest), so only the
    # background connected to the image border is removed, unless holes=True.
    if kind == "distance" and not holes:
        region = bytearray(n)
        # flood only through clear background, then grow 2 px into the soft edge band
        q_ = deque(i for i in border_idx if likes[i] >= tolerance)
        for i in q_:
            region[i] = 1
        while q_:
            i = q_.popleft()
            x = i % w
            for j in (i - w, i + w, i - 1 if x else -1, i + 1 if x < w - 1 else -1):
                if 0 <= j < n and not region[j] and likes[j] >= tolerance:
                    region[j] = 1
                    q_.append(j)
        for _ in range(2):
            grow = []
            for i in range(n):
                if region[i] or likes[i] <= lo:
                    continue
                x = i % w
                if (i >= w and region[i - w]) or (i + w < n and region[i + w]) or \
                        (x and region[i - 1]) or (x < w - 1 and region[i + 1]):
                    grow.append(i)
            for i in grow:
                region[i] = 1
    else:
        region = None

    rgb = bytearray(n * 3)
    alpha = bytearray(n)
    for i in range(n):
        r, g, b = px[i * ch], px[i * ch + 1], px[i * ch + 2]
        q = likes[i]
        if region is not None and not region[i]:
            q = 0.0
        if q >= tolerance:
            continue
        a = 1.0 if q <= lo else (tolerance - q) / softness
        if despill and a < 1.0:  # unmix the key colour out of soft edge pixels
            inv = 1.0 - a
            d = a if a > 0.25 else 0.25
            r = min(255, max(0, round((r - inv * kr) / d)))
            g = min(255, max(0, round((g - inv * kg) / d)))
            b = min(255, max(0, round((b - inv * kb) / d)))
        if despill and kind != "distance" and q > 0:  # spill suppression
            if kind == "green":
                g = min(g, max(r, b))
            elif kind == "magenta":
                excess = min(r, b) - g
                if excess > 0:
                    r, b = r - excess, b - excess
            else:
                b = min(b, max(r, g))
        rgb[i * 3:i * 3 + 3] = bytes((r, g, b))
        alpha[i] = round(a * 255)
    return rgb, alpha, {"key": f"#{kr:02x}{kg:02x}{kb:02x}", "key_kind": kind,
                        "border_match": round(uniform, 3)}


def method_vision(src_path, w, h, ch, px, despill):
    if sys.platform != "darwin":
        die("--method vision needs macOS 14 or later", 5)
    swift_src = os.path.join(os.path.dirname(os.path.realpath(__file__)), "vision-mask.swift")
    if not os.path.isfile(VISION_BIN) or os.path.getmtime(VISION_BIN) < os.path.getmtime(swift_src):
        if not shutil.which("swiftc"):
            die("--method vision needs swiftc (xcode-select --install)", 5)
        os.makedirs(os.path.dirname(VISION_BIN), exist_ok=True)
        r = subprocess.run(["swiftc", "-O", swift_src, "-o", VISION_BIN], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"could not compile vision-mask: {r.stderr.strip()[-400:]}", 5)
    with tempfile.TemporaryDirectory() as tmp:
        mask_path = os.path.join(tmp, "mask.png")
        r = subprocess.run([VISION_BIN, src_path, mask_path], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"vision failed: {r.stderr.strip()}", 5)
        mw, mh, mch, mpx = read_png(mask_path)
    if (mw, mh) != (w, h):
        die(f"vision mask size {mw}x{mh} differs from image {w}x{h}", 5)
    alpha = bytearray(mpx[0::mch])
    rgb = bytearray(w * h * 3)
    rgb[0::3], rgb[1::3], rgb[2::3] = px[0::ch], px[1::ch], px[2::ch]
    if despill:  # unmix the measured border colour from soft edges
        border, _ = border_pixels(w, h, ch, px)
        kr, kg, kb = (median([p[c] for p in border]) for c in range(3))
        for i, a8 in enumerate(alpha):
            if 0 < a8 < 255:
                a = a8 / 255
                inv, d = 1 - a, max(a, 0.25)
                rgb[i * 3] = min(255, max(0, round((rgb[i * 3] - inv * kr) / d)))
                rgb[i * 3 + 1] = min(255, max(0, round((rgb[i * 3 + 1] - inv * kg) / d)))
                rgb[i * 3 + 2] = min(255, max(0, round((rgb[i * 3 + 2] - inv * kb) / d)))
    return rgb, alpha


# ---------------------------------------------------------------- output

def assemble(w, h, rgb, alpha):
    out = bytearray(w * h * 4)
    out[0::4], out[1::4], out[2::4], out[3::4] = rgb[0::3], rgb[1::3], rgb[2::3], alpha
    for i, a in enumerate(alpha):  # no hidden colour under fully transparent pixels
        if a == 0:
            out[i * 4:i * 4 + 3] = b"\x00\x00\x00"
    return out


def bbox(w, h, alpha):
    xs0, ys0, xs1, ys1 = w, h, -1, -1
    for y in range(h):
        row = alpha[y * w:(y + 1) * w]
        if any(row):
            ys0, ys1 = min(ys0, y), y
            first = next(x for x, a in enumerate(row) if a)
            last = w - 1 - next(x for x, a in enumerate(reversed(row)) if a)
            xs0, xs1 = min(xs0, first), max(xs1, last)
    return (xs0, ys0, xs1, ys1) if xs1 >= 0 else None


def crop(w, h, rgba, box, pad):
    x0, y0 = max(0, box[0] - pad), max(0, box[1] - pad)
    x1, y1 = min(w - 1, box[2] + pad), min(h - 1, box[3] + pad)
    nw, nh = x1 - x0 + 1, y1 - y0 + 1
    out = bytearray()
    for y in range(y0, y1 + 1):
        out += rgba[(y * w + x0) * 4:(y * w + x1 + 1) * 4]
    return nw, nh, out


def preview(path, w, h, rgba, panel=480):
    s = max(w, h) / panel
    pw, ph = max(1, int(w / s)), max(1, int(h / s))
    gap = 8
    W = pw * 3 + gap * 2
    out = bytearray(b"\xff" * (W * ph * 3))
    for py in range(ph):
        sy = min(h - 1, int(py * s))
        for px_ in range(pw):
            sx = min(w - 1, int(px_ * s))
            k = (sy * w + sx) * 4
            r, g, b, a = rgba[k], rgba[k + 1], rgba[k + 2], rgba[k + 3] / 255
            check = 205 if ((px_ // 12 + py // 12) % 2) else 255
            for n, bg in enumerate(((check,) * 3, (0, 0, 0), (255, 255, 255))):
                o = (py * W + n * (pw + gap) + px_) * 3
                out[o] = round(r * a + bg[0] * (1 - a))
                out[o + 1] = round(g * a + bg[1] * (1 - a))
                out[o + 2] = round(b * a + bg[2] * (1 - a))
    write_png(path, W, ph, 3, out)


def stats(w, h, rgba, alpha, extra):
    n = w * h
    transparent = alpha.count(0)
    opaque = alpha.count(255)
    border_idx = set(range(w)) | set(range((h - 1) * w, h * w)) | \
        set(range(0, n, w)) | set(range(w - 1, n, w))
    hidden = sum(1 for i in range(n) if alpha[i] == 0 and any(rgba[i * 4:i * 4 + 3]))
    s = {
        "size": [w, h],
        "transparent_pct": round(100 * transparent / n, 2),
        "soft_edge_pct": round(100 * (n - transparent - opaque) / n, 2),
        "opaque_pct": round(100 * opaque / n, 2),
        "near_opaque_pct": round(100 * sum(1 for a in alpha if 230 <= a < 255) / n, 2),
        "border_max_alpha": max(alpha[i] for i in border_idx),
        "hidden_colour_under_alpha0": hidden,
    }
    s.update(extra)
    return s


def main():
    argv = sys.argv[1:]
    if len(argv) < 2 or argv[0].startswith("--"):
        die("usage: gpt-image-cutout <source> <output.png> [--method auto|finish|chroma|vision] "
            "[--key ...] [--trim [PAD]] [--overwrite] (see --help)") if argv != ["--help"] else \
            (print(__doc__), sys.exit(0))
    src, out = os.path.abspath(os.path.expanduser(argv[0])), os.path.abspath(os.path.expanduser(argv[1]))
    opts = {"method": "auto", "key": "auto", "tolerance": 0.80, "softness": 0.55,
            "opaque_from": 245, "clear_below": 4, "min_speck": 64, "despill": True,
            "trim": None, "overwrite": False, "holes": False, "fill_holes": True,
            "despill_vision": False}
    rest, i = argv[2:], 0
    while i < len(rest):
        a = rest[i]
        nxt = rest[i + 1] if i + 1 < len(rest) else None
        if a == "--no-despill":
            opts["despill"] = False; i += 1
        elif a == "--despill":
            opts["despill_vision"] = True; i += 1
        elif a == "--no-fill-holes":
            opts["fill_holes"] = False; i += 1
        elif a == "--holes":
            opts["holes"] = True; i += 1
        elif a == "--overwrite":
            opts["overwrite"] = True; i += 1
        elif a == "--trim":
            if nxt is not None and nxt.isdigit():
                opts["trim"] = int(nxt); i += 2
            else:
                opts["trim"] = 8; i += 1
        elif nxt is None:
            die(f"incomplete arg: {a}")
        elif a == "--method" and nxt in ("auto", "finish", "chroma", "vision"):
            opts["method"] = nxt; i += 2
        elif a == "--key":
            opts["key"] = nxt; i += 2
        elif a in ("--tolerance", "--softness"):
            try:
                opts[a[2:]] = float(nxt)
            except ValueError:
                die(f"{a} needs a number, got {nxt!r}")
            i += 2
        elif a in ("--opaque-from", "--clear-below", "--min-speck"):
            try:
                opts[a[2:].replace("-", "_")] = int(nxt)
            except ValueError:
                die(f"{a} needs a whole number, got {nxt!r}")
            i += 2
        else:
            die(f"unknown or invalid arg: {a} {nxt}")

    if not os.path.isfile(src):
        die(f"source not found: {src}")
    if not out.lower().endswith(".png"):
        die("output must end in .png")
    if not os.path.isdir(os.path.dirname(out)):
        die(f"output dir does not exist: {os.path.dirname(out)}")
    if out == src:
        die("output must differ from the source (keep the Codex original)")
    prev_path = os.path.splitext(out)[0] + ".preview.png"
    if src == prev_path:
        die("the preview of this output would overwrite the source; pick another output name")
    for path in (out, prev_path):
        if os.path.exists(path) and not opts["overwrite"]:
            die(f"output already exists: {path} (pick a new name or pass --overwrite)")

    w, h, ch, px = load_image(src)
    # "has alpha" means real transparency, not just an alpha channel that is fully opaque
    has_alpha = ch == 4 and min(px[3::4]) < 128
    method = opts["method"]
    if method == "auto":
        method = "finish" if has_alpha else "chroma"
    if method == "finish" and not has_alpha:
        die("source has no transparency (no alpha channel, or alpha is opaque everywhere); "
            "use --method chroma or vision", 4)

    extra = {"method": method, "source_has_alpha": has_alpha}
    if method == "finish":
        rgb, alpha = method_finish(w, h, px)
    elif method == "chroma":
        rgb, alpha, info = method_chroma(w, h, ch, px, opts["key"], opts["tolerance"],
                                         opts["softness"], opts["despill"], opts["holes"])
        extra.update(info)
    else:
        rgb, alpha = method_vision(src, w, h, ch, px, opts["despill_vision"])
    snap_alpha(alpha, opts["opaque_from"], opts["clear_below"])
    extra["snapped"] = [opts["clear_below"], opts["opaque_from"]]
    extra["pieces"] = remove_specks(w, h, alpha, opts["min_speck"])
    extra["false_holes_filled_px"] = fill_false_holes(w, h, alpha) if opts["fill_holes"] else 0

    rgba = assemble(w, h, rgb, alpha)
    box = bbox(w, h, alpha)
    if box is None:
        die("nothing left after cutout: the whole image became transparent", 4)
    extra["subject_bbox"] = list(box)
    if opts["trim"] is not None:
        w, h, rgba = crop(w, h, rgba, box, opts["trim"])
        alpha = bytearray(rgba[3::4])
    write_png(out, w, h, 4, rgba)
    preview(prev_path, w, h, rgba)
    s = stats(w, h, rgba, alpha, extra)
    s["output"], s["preview"] = out, prev_path
    print(json.dumps(s, indent=2))


if __name__ == "__main__":
    main()
